local T = _G.T
local Format = require("../src/shared/Format")
local StackCodec = require("../src/shared/StackCodec")

T.describe("Format", function()
	T.it("short numbers", function()
		T.eq(Format.short(999), "999")
		T.eq(Format.short(1000), "1K")
		T.eq(Format.short(1500), "1.5K")
		T.eq(Format.short(12345), "12.3K")
		T.eq(Format.short(150000), "150K")
		T.eq(Format.short(100000), "100K")
		T.eq(Format.short(2500000), "2.5M")
		T.eq(Format.short(1e9), "1B")
	end)

	T.it("commas", function()
		T.eq(Format.commas(0), "0")
		T.eq(Format.commas(1234567), "1,234,567")
		T.eq(Format.commas(-1000), "-1,000")
		T.eq(Format.commas(100), "100")
	end)

	T.it("multiplier", function()
		T.eq(Format.multiplier(2), "x2")
		T.eq(Format.multiplier(10), "x10")
		T.eq(Format.multiplier(1.25), "x1.25")
		T.eq(Format.multiplier(1.5), "x1.5")
	end)

	T.it("duration", function()
		T.eq(Format.duration(65), "1:05")
	end)
end)

T.describe("StackCodec", function()
	T.it("round trips", function()
		local codes = { "apl", "cans", "pigg" }
		local decoded = StackCodec.decode(StackCodec.encode(codes))
		T.eq(#decoded, 3)
		T.eq(decoded[3], "pigg")
		local id, rarity = StackCodec.parse("pigg")
		T.eq(id, "pig")
		T.eq(rarity, "g")
		T.eq(#StackCodec.decode(""), 0)
		T.eq(#StackCodec.decode(nil), 0)
	end)
end)
