local T = _G.T
local Framing = require("../src/shared/CameraFraming")
T.describe("Tower camera framing", function()
	T.it("fits a tall tower in portrait as well as landscape", function()
		local wide, offset = Framing.overview(100, 16 / 9, 70)
		local narrow = Framing.overview(100, 9 / 16, 70)
		T.truthy(narrow > wide)
		T.eq(offset, 50)
		T.truthy(wide > 100 / 2 / math.tan(math.rad(35)))
	end)
	T.it("handles empty towers and degenerate viewports", function()
		local distance, offset = Framing.overview(0, 0, 70)
		T.truthy(distance >= 18 and distance < math.huge)
		T.eq(offset, 0)
	end)
end)
